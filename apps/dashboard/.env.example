# Port dashboard
PORT=4100

# Secret untuk session login / access token (contoh: openssl rand -hex 32)
SESSION_SECRET=change-me-long-random-secret

# Secret terpisah untuk refresh token (WAJIB di produksi, min 32 karakter)
# Jika dikosongkan, otomatis fallback ke SESSION_SECRET (tidak disarankan).
REFRESH_SECRET=change-me-another-long-random-secret

# Masa berlaku token (opsional, default di bawah)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# Set "true" hanya jika dashboard diakses via HTTPS
# COOKIE_SECURE=false

# Login dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password

# Daftar agent PM2: JSON array [{name, url, token}]
# url = alamat agent (biasanya 127.0.0.1:<port>)
DASHBOARD_SERVERS=[{"name":"vps-1","url":"http://127.0.0.1:4001","token":"change-me-strong-random-token"}]
