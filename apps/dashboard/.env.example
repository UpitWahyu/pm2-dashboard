# Port dashboard
PORT=3000

# Secret untuk session login (contoh: openssl rand -hex 32)
SESSION_SECRET=change-me-long-random-secret

# Login dashboard (fase 1)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password

# Daftar agent PM2: JSON array [{name, url, token}]
# url = alamat agent (biasanya 127.0.0.1:<port> atau via tunnel/NPM)
DASHBOARD_SERVERS=[{"name":"vps-1","url":"http://127.0.0.1:4001","token":"change-me-strong-random-token"}]
